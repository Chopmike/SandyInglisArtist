      <stop offset="0%" style="stop-color:#6B2828;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#8B3A3A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c2c2c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="800" fill="url(#grad2)"/>
  <rect x="150" y="200" width="300" height="400" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.3)" stroke-width="4"/>
